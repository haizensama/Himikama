# Himikama repository ignore policy

# -----------------------------------------------------------------------------
# Secrets and local configuration
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!**/.env.example
!**/.env.*.example
.envrc

secrets/
**/firebase-service-account*.json
**/*firebase*service*account*.json
**/*service-account-key*.json
**/serviceAccountKey*.json

*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
key.properties

.pypirc
.npmrc

# Firebase client configuration is intentionally not ignored:
#   frontend/android/app/google-services.json
#   frontend/lib/firebase_options.dart

# -----------------------------------------------------------------------------
# Sensitive local records and generated data stores
# -----------------------------------------------------------------------------
backend/attempts/
backend/db/
backend/logs/
backend/tmp/

# Firebase emulator and CLI artifacts
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
database-debug.log
ui-debug.log

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[codz]
*$py.class
*.so

.Python
.venv/
venv/
env/
ENV/
__pypackages__/

build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
*.cover
*.py.cover

.ipynb_checkpoints/
.scrapy/
.webassets-cache
.pybuilder/
cython_debug/
docs/_build/

# -----------------------------------------------------------------------------
# Flutter / Dart / Android / iOS
# -----------------------------------------------------------------------------
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.pub-cache/
frontend/.pub/
frontend/build/
frontend/coverage/
frontend/**/doc/api/

frontend/android/.gradle/
frontend/android/captures/
frontend/android/local.properties
frontend/android/**/key.properties
frontend/android/**/.cxx/
frontend/android/app/debug/
frontend/android/app/profile/
frontend/android/app/release/
frontend/android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java

frontend/ios/Flutter/.last_build_id
frontend/ios/Flutter/ephemeral/
frontend/ios/Flutter/Generated.xcconfig
frontend/ios/Flutter/flutter_export_environment.sh
frontend/ios/Pods/
frontend/ios/.symlinks/
frontend/ios/**/DerivedData/
frontend/ios/**/xcuserdata/

app.*.symbols
app.*.map.json

# -----------------------------------------------------------------------------
# IDE, editor, OS and temporary files
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.log
*.bak
*.old
*.orig
*.rej
*.before_*

# Local copies and superseded evaluation output
frontend_backup_*/
Temp Evaluations/
backend/evaluation/outputs_partial_clean/
backend/evaluation/full_himikama_outputs.jsonl
