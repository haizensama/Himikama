# Copy these names into your deployment secret/configuration system.
# Never commit a populated .env file or service-account JSON.

ENVIRONMENT=production
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
DB_PATH=db/
LOG_LEVEL=INFO

# Prefer Application Default Credentials / workload identity in production.
FIREBASE_PROJECT_ID=replace-with-production-project-id
FIRESTORE_USERS_COLLECTION=users
FIRESTORE_ANALYSIS_JOBS_COLLECTION=analysis_jobs
FIREBASE_CHECK_REVOKED_TOKENS=true
FIREBASE_REQUIRE_VERIFIED_EMAIL=true
FIREBASE_REQUIRE_APP_CHECK=true

ANALYSIS_WORKER_ENABLED=true
ANALYSIS_WORKER_POLL_SECONDS=2
ANALYSIS_JOB_LEASE_SECONDS=120
ANALYSIS_JOB_HEARTBEAT_SECONDS=30
ANALYSIS_JOB_SCAN_LIMIT=25

ACCOUNT_DELETION_WORKER_ENABLED=true
ACCOUNT_DELETION_WORKER_POLL_SECONDS=60
ACCOUNT_DELETION_LEASE_SECONDS=300
ACCOUNT_DELETION_SCAN_LIMIT=25
ACCOUNT_DELETION_RECOVERY_DAYS=7

# Native mobile clients do not require browser CORS origins. Add only the
# explicit HTTPS origins of any separately deployed web client.
CORS_ALLOWED_ORIGINS=
MAX_REQUEST_BYTES=65536
HISTORY_MAX_LIMIT=50
RECENT_AUTH_MAX_AGE_SECONDS=600
CURRENT_TERMS_VERSION=1.0
CURRENT_PRIVACY_VERSION=1.1
CURRENT_ASSESSMENT_CONSENT_VERSION=1.0
